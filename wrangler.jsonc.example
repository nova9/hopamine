{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hopamine",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-17",
  "vars": {
    "ACCESS_TEAM_DOMAIN": "REPLACE_WITH_YOUR_TEAM.cloudflareaccess.com",
    "ACCESS_AUD": "REPLACE_WITH_YOUR_ACCESS_APPLICATION_AUD",
  },
  "access": {
    "dev": {
      "aud": "hopamine-local",
      "identity": {
        "email": "moderator@hopamine.local",
      },
    },
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "ratelimits": [
    {
      "name": "SUBMISSION_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 3,
        "period": 60,
      },
    },
    {
      "name": "GLOBAL_UPLOAD_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 30,
        "period": 60,
      },
    },
  ],
  "d1_databases": [
    {
      "binding": "hopamine_db",
      "database_name": "hopamine-db",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
    },
  ],
  "r2_buckets": [
    {
      "binding": "hopamine_files",
      "bucket_name": "hopamine-files",
    },
  ],
}
